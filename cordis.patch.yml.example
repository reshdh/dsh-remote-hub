# dsh-remote-hub — 静态挂载示例
#
# 不想走插件管理（「插件」页或 `dsh plugin --profile <name> add`）的话，
# 把下面这段抄进你 DSH profile 的
# cordis.patch.yml，并把 <ABSOLUTE_PATH> 换成本仓库的 clone 目录。
# 走插件管理的正常安装不需要这个文件——包自带的
# cordis.patch.yml 挂的就是这一行。
#
# 行配置（全部可省，走默认值；settings 页保存的值优先于这里手写的）：
- insert:
    - id: dsh-remote-hub
      name: dsh-remote-hub
      path: file:///ABSOLUTE_PATH/dsh-remote-hub/lib/index.js
      config:
        role: host                # host（主服务端，默认）| client（子客户端）
        serverName: My-Mac        # 服务端显示名，出现在子客户端分组标题里（≤40 字）
        port: 3088                # 网关端口
        host: 127.0.0.1           # 网关监听地址
        trustedProxies: ""        # 反代不在本机时填它的出口 IP，逗号分隔
        idleHours: 48             # 远程会话闲置休眠时长（小时）
        autoShareNewSessions: false  # 新建会话自动开启远程
        # 子客户端角色要填的两项：
        # serverUrl: https://dsh.example.com
        # deviceToken: <配对拿到的设备令牌>
